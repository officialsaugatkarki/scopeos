# ============================================================
# ScopeOS Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ---- Supabase ----
# Found at: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service Role Key — server-only, never use NEXT_PUBLIC_ prefix
# Found at: Supabase → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---- App URL ----
# Local: http://localhost:3000
# Production: https://scopeos.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Google Gemini AI ----
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Resend Email API ----
# Found at: https://resend.com/api-keys
# Domain k-kinfotech.com is verified in Resend — use noreply@k-kinfotech.com as the sender.
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=ScopeOS <noreply@k-kinfotech.com>
