# ============================================================
# ScopeOS Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ---- Supabase ----
# Found at: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service Role Key — server-only, never use NEXT_PUBLIC_ prefix
# Found at: Supabase → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---- App URL ----
# Local: http://localhost:3000
# Production: https://scopeos.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Google Gemini AI ----
GEMINI_API_KEY=your_gemini_api_key_here

# ---- EmailJS (Server-side only — called from API routes via REST) ----
# DO NOT add NEXT_PUBLIC_ prefix — these must stay server-side only
# EMAILJS_PRIVATE_KEY is required because Strict Mode is enabled on your EmailJS account
# Found at: https://dashboard.emailjs.com/admin/account
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
